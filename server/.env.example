# Copy to .env for local reference, then export these values in your shell/host.
NOOK_DEVICE_ID=AA:BB:CC:DD:EE:FF
NOOK_API_KEY=replace-with-a-long-random-value

# Set this to the public HTTPS origin after deployment. Leave blank for local tests.
PUBLIC_BASE_URL=https://your-byos-host.example
REFRESH_RATE_SECONDS=300

# Server-only Supabase access. Never expose these values to the browser or Nook.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_server-only-placeholder

# Generate an independent high-entropy value; do not reuse NOOK_API_KEY.
SCREEN_SIGNING_SECRET=generate-an-independent-random-secret-at-least-32-characters
SCREEN_URL_TTL_SECONDS=900
